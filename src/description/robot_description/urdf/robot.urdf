  <!-- Source Joint_29, renamed. A 0.1565 mm zero-height correction removes
       the source mesh tolerance so all four tyre minima coincide at z=0. -->
  <joint name="active_suspension_joint" type="prismatic">
    <parent link="chassis_base"/>
    <child link="active_suspension_carriage"/>
    <origin rpy="0 -0.00000367 1.5708" xyz="-0.22999973 -0.07495992 0.638259125"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-0.15" upper="0" velocity="0.1"/>
  </joint>
  <joint name="caster02_joint" type="revolute">
    <parent link="active_suspension_carriage"/>
    <child link="caster02"/>
    <origin rpy="-3.14159265 0 1.57079633" xyz="-0.22999997 0.075 -0.68384998"/>
    <axis xyz="0 0 1"/>
