    <axis xyz="0 0 1"/>
    <limit effort="10" lower="-3.14159" upper="3.14159" velocity="1"/>
  </joint>
  <!-- Stable system-facing root frames. base_footprint is the ground reference;
       base_link uses the measured V3 installation offset. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0.195 0.015 0.400"/>
  </joint>
  <link name="base_link"/>
  <!-- CAD chassis root is 45.584858 mm above its plate bottom. The wheels
       extend 320 mm below that bottom; preserve the existing chassis XY center. -->
  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_base"/>
    <origin rpy="0 0 0" xyz="-0.19 0 -0.034415142"/>
  </joint>
  <joint name="base_to_model" type="fixed">
    <parent link="base_link"/>
    <child link="model_base"/>
    <origin rpy="1.5707963 0 1.57079632679" xyz="-0.190000017371 6.50500004219e-09 0.662499964909"/>
  </joint>
