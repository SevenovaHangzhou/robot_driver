<?xml version="1.0" encoding="UTF-8"?>
<!--
  V3.1.1 双臂运动链集成到 Kkozia 模块化整机。
  底盘、主动悬挂、双轴头部、夹爪/吸盘和 Tool0 保持目标分支定义。
  Updown 保持同一 1m 实体行程，重标为 -1m 最低、0m 最高。
-->
