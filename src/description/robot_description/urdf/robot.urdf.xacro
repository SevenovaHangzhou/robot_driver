<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="alfa_robot_v3">
  <!--
    ALFA V3.0.9 geometry and kinematics entrypoint.
    end_effector:=suction (default) or end_effector:=gripper selects both tools.

    This branch intentionally contains description assets only. Hardware
    interfaces, MoveIt semantics, controller configuration and sensor
    extrinsics belong to their owning packages and are not inferred here.
  -->

  <xacro:arg name="end_effector" default="suction" />
  <xacro:include filename="$(find robot_description)/urdf/robot_v3_0_9.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/robot_v3_chassis.xacro"/>

  <!-- Stable system-facing root frames. base_footprint is the ground reference;
       base_link uses the measured V3 installation offset. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.195 0.015 0.400" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>
  <!-- CAD chassis root is 45.584858 mm above its plate bottom. The wheels
       extend 320 mm below that bottom; preserve the existing chassis XY center. -->
  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_base"/>
    <origin xyz="-0.19 0 -0.034415142" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_model" type="fixed">
    <parent link="base_link"/>
    <child link="model_base"/>
    <origin
      xyz="-0.190000017371 6.50500004219e-09 0.662499964909"
      rpy="1.5707963 0 1.57079632679"/>
  </joint>
</robot>
