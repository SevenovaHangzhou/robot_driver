#!/usr/bin/env bash
set -uo pipefail

child_pid=""
shutdown_started=0
orderly_disable_required=0
shutdown_command=()

forward_shutdown() {
  if (( shutdown_started != 0 )); then
    return
  fi
  shutdown_started=1

  if (( orderly_disable_required != 0 )); then
    if ! "${shutdown_command[@]}"; then
      echo "UNCLEAN_SHUTDOWN: orderly rt-control shutdown sequence did not complete" >&2
    fi
  fi

  if [[ -n "${child_pid}" ]] && kill -0 "${child_pid}" 2>/dev/null; then
    kill -INT -- "-${child_pid}" 2>/dev/null || kill -INT "${child_pid}" 2>/dev/null || true
  fi
}

trap forward_shutdown INT TERM

launch_file=rt_control_module.launch.py
# Named entries are aliases of the generic staged scope runtime.
if [[ "${1:-}" == "--enable-only" ]]; then
  shift
  exec "$0" --scope arms_stationary_enable physical_profile:=arms_only "$@"
elif [[ "${1:-}" == "--arm-jtc" ]]; then
  shift
  exec "$0" --scope arms_only jtc_only:=true "$@"
elif [[ "${1:-}" == "--arm-runtime" ]]; then
  shift
  exec "$0" --scope arms_only "$@"
elif [[ "${1:-}" == "--force-sensors" ]]; then
  shift
  exec "$0" --scope force_bench "$@"
elif [[ "${1:-}" == "--scope" ]]; then
  # Generic staged scope runtime; the artifact's lifecycle plan drives the teardown.
  if [[ -z "${2:-}" ]]; then
    echo "BOOT_ERROR: --scope requires a control scope name" >&2
    exit 2
  fi
  scope_name="$2"
  shift 2
  generated_dir="${RT_CONTROL_GENERATED_DIR:-}"
  for argument in "$@"; do
    if [[ "${argument}" == generated_dir:=* ]]; then
      generated_dir="${argument#generated_dir:=}"
    fi
  done
  if [[ -z "${generated_dir}" ]]; then
    echo "BOOT_ERROR: --scope requires generated_dir:=<artifact> or RT_CONTROL_GENERATED_DIR" >&2
    exit 2
  fi
  launch_file=rt_control_scope_runtime.launch.py
  orderly_disable_required=1
  shutdown_command=(ros2 run integ_bringup scope_shutdown "${generated_dir}")
  set -- control_scope:="${scope_name}" generated_dir:="${generated_dir}" "$@"
elif [[ "${1:-}" == "--head-runtime" ]]; then
  # The head is driven by enable_manager under the generic staged scope runtime.
  shift
  exec "$0" --scope head_only "$@"
fi
launch_command=(ros2 launch integ_bringup "${launch_file}" "$@")
if [[ -n "${RT_CONTROL_START_CPUSET:-}" ]]; then
  if ! command -v taskset >/dev/null 2>&1; then
    echo "BOOT_ERROR: RT_CONTROL_START_CPUSET requires taskset but taskset is missing" >&2
    exit 1
  fi
  launch_command=(taskset --cpu-list "${RT_CONTROL_START_CPUSET}" "${launch_command[@]}")
fi

setsid "${launch_command[@]}" &
child_pid=$!
exit_code=0
while kill -0 "${child_pid}" 2>/dev/null; do
  wait "${child_pid}"
  exit_code=$?
done
trap - INT TERM
exit "${exit_code}"
