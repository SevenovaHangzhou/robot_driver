<?xml version="1.0"?>
<package format="3">
  <name>hw_can_damiao</name>
  <version>0.1.0</version>
  <description>Native SocketCAN ros2_control hardware plugin for two DaMiao head motors.</description>
  <maintainer email="kkozia188@gmail.com">kkozia</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>infra_socketcan</depend>
  <depend>hw_semantic_components</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
