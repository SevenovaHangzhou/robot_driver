<?xml version="1.0"?>
<!-- Synthetic analytical fixture, not physical robot parameters. -->
<robot name="synthetic_pendulum">
  <link name="base"/>
  <link name="auxiliary_link"/>
  <joint name="auxiliary_turn" type="continuous"><parent link="base"/><child link="auxiliary_link"/>
    <axis xyz="0 0 1"/></joint>
  <link name="right_joint1"><inertial><origin xyz="0.4 0 0"/>
    <mass value="2"/><inertia ixx="0.02" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
  </inertial></link>
  <joint name="right_joint1" type="revolute"><parent link="base"/><child link="right_joint1"/>
    <axis xyz="0 1 0"/><limit lower="-3" upper="3" effort="100" velocity="2"/>
  </joint>
  <link name="right_joint2"><inertial><origin xyz="0.3 0 0"/>
    <mass value="3"/><inertia ixx="0.03" iyy="0.12" izz="0.12" ixy="0" ixz="0" iyz="0"/>
  </inertial></link>
  <joint name="right_joint2" type="revolute"><parent link="right_joint1"/><child link="right_joint2"/>
    <origin xyz="0.8 0 0"/><axis xyz="0 1 0"/><limit lower="-3" upper="3" effort="100" velocity="2"/>
  </joint>
  <link name="tool"/>
  <joint name="tool_mount" type="fixed"><parent link="right_joint2"/><child link="tool"/>
    <origin xyz="0.6 0 0" rpy="0 0 0.3"/>
  </joint>
</robot>
