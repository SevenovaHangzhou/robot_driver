<?xml version="1.0"?>
<!-- Synthetic dual 7-DoF fixture; masses are test-only and unrelated to V3. -->
<robot name="synthetic_dual_seven">
  <link name="base"/>
  <link name="left_joint1"><inertial><origin xyz="0.1 0 0"/><mass value="1"/><inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="left_joint1" type="revolute"><parent link="base"/><child link="left_joint1"/><axis xyz="0 1 0"/><limit lower="-3" upper="3" effort="30" velocity="2"/></joint>
  <link name="left_joint2"><inertial><origin xyz="0.1 0 0"/><mass value="1"/><inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial></link>
