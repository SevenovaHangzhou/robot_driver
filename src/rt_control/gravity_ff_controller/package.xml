<?xml version="1.0"?>
<package format="3">
  <name>gravity_ff_controller</name><version>0.1.0</version>
  <description>Fail-closed CSP torque-offset gravity feedforward controller.</description>
  <maintainer email="kkozia188@gmail.com">kkozia</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>controller_interface</depend><depend>diagnostic_msgs</depend>
  <depend>hardware_interface</depend><depend>openssl</depend><depend>pluginlib</depend>
  <depend>rclcpp</depend><depend>realtime_tools</depend><depend>rt_arm_dynamics</depend>
  <test_depend>ament_cmake_gtest</test_depend><test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend><test_depend>controller_manager</test_depend>
  <test_depend>enable_manager</test_depend><test_depend>joint_trajectory_controller</test_depend>
  <export><build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/gravity_ff_plugins.xml"/>
  </export>
</package>
