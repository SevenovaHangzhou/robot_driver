<robot name="swerve_mock">
  <link name="base" />
  <link name="steer1" />
  <joint name="steer1_joint" type="continuous"><parent link="base" /><child link="steer1" /><axis xyz="0 0 1" /></joint>
  <link name="wheel1" />
  <joint name="wheel1_joint" type="continuous"><parent link="base" /><child link="wheel1" /><axis xyz="0 0 1" /></joint>
  <link name="steer2" />
  <joint name="steer2_joint" type="continuous"><parent link="base" /><child link="steer2" /><axis xyz="0 0 1" /></joint>
  <link name="wheel2" />
  <joint name="wheel2_joint" type="continuous"><parent link="base" /><child link="wheel2" /><axis xyz="0 0 1" /></joint>
  <link name="steer3" />
  <joint name="steer3_joint" type="continuous"><parent link="base" /><child link="steer3" /><axis xyz="0 0 1" /></joint>
  <link name="wheel3" />
  <joint name="wheel3_joint" type="continuous"><parent link="base" /><child link="wheel3" /><axis xyz="0 0 1" /></joint>
  <link name="steer4" />
  <joint name="steer4_joint" type="continuous"><parent link="base" /><child link="steer4" /><axis xyz="0 0 1" /></joint>
  <link name="wheel4" />
  <joint name="wheel4_joint" type="continuous"><parent link="base" /><child link="wheel4" /><axis xyz="0 0 1" /></joint>
  </robot>
