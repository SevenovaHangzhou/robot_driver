<?xml version="1.0"?>
<package format="3">
  <name>infra_renderer</name>
  <version>0.1.0</version>
  <description>Offline helpers shared by protocol-owned rt_control renderers: owner schema validation and ros2_control XML params (no ROS dependency).</description>
  <maintainer email="kkozia188@gmail.com">kkozia</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>python3-jsonschema</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
