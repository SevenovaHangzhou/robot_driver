{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "assembly": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module_position": {
            "type": "string",
            "minLength": 1
          },
          "resource_name": {
            "type": "string",
            "minLength": 1
          },
          "node_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "TBD"
              }
            ]
          },
          "device": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "module_position",
          "resource_name",
          "node_id",
          "device"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "assembly",
    "profile",
    "nodes"
  ],
  "additionalProperties": false
}
