#!/usr/bin/env bash
set -uo pipefail

child_pid=""
shutdown_started=0
orderly_disable_required=0
shutdown_command=(ros2 run enable_manager rt_disable_once)

forward_shutdown() {
  if (( shutdown_started != 0 )); then
    return
  fi
  shutdown_started=1

  if (( orderly_disable_required != 0 )); then
    if ! "${shutdown_command[@]}"; then
      echo "UNCLEAN_SHUTDOWN: orderly rt-control shutdown sequence did not complete" >&2
    fi
  fi

  if [[ -n "${child_pid}" ]] && kill -0 "${child_pid}" 2>/dev/null; then
    kill -INT -- "-${child_pid}" 2>/dev/null || kill -INT "${child_pid}" 2>/dev/null || true
  fi
}

trap forward_shutdown INT TERM

launch_file=rt_control_module.launch.py
if [[ "${1:-}" == "--enable-only" ]]; then
  launch_file=rt_control_enable_only.launch.py
  orderly_disable_required=1
  shift
elif [[ "${1:-}" == "--arm-jtc" ]]; then
  launch_file=rt_control_arm_runtime.launch.py
  orderly_disable_required=1
  shift
  set -- jtc_only:=true "$@"
elif [[ "${1:-}" == "--arm-runtime" ]]; then
  launch_file=rt_control_arm_runtime.launch.py
  orderly_disable_required=1
  shift
elif [[ "${1:-}" == "--head-runtime" ]]; then
  launch_file=rt_control_head_runtime.launch.py
  orderly_disable_required=1
  shutdown_command=(ros2 run damiao_head_controller head_disable_once)
  shift
fi
launch_command=(ros2 launch rt_control_bringup "${launch_file}" "$@")
if [[ -n "${RT_CONTROL_START_CPUSET:-}" ]]; then
  if ! command -v taskset >/dev/null 2>&1; then
    echo "BOOT_ERROR: RT_CONTROL_START_CPUSET requires taskset but taskset is missing" >&2
    exit 1
  fi
  launch_command=(taskset --cpu-list "${RT_CONTROL_START_CPUSET}" "${launch_command[@]}")
fi

setsid "${launch_command[@]}" &
child_pid=$!
exit_code=0
while kill -0 "${child_pid}" 2>/dev/null; do
  wait "${child_pid}"
  exit_code=$?
done
trap - INT TERM
exit "${exit_code}"
