{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "family": {
      "const": "tongyi"
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "identity_key": {
      "type": "string",
      "minLength": 1
    },
    "metres_per_motor_turn": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": "TBD"
        }
      ]
    },
    "stroke_min_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "const": "TBD"
        }
      ]
    },
    "stroke_max_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "const": "TBD"
        }
      ]
    },
    "hard_stop_margin_m": {
      "type": "number",
      "minimum": 0
    },
    "max_velocity_m_s": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": "TBD"
        }
      ]
    },
    "profile_acceleration_ms_per_krpm": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "TBD"
        }
      ]
    },
    "profile_deceleration_ms_per_krpm": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "TBD"
        }
      ]
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "robot_model_joint": {
            "type": "string",
            "minLength": 1
          },
          "ring_position": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "TBD"
              }
            ]
          },
          "device": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  -1,
                  1
                ]
              },
              {
                "const": "TBD"
              }
            ]
          }
        },
        "required": [
          "robot_model_joint",
          "ring_position",
          "device",
          "direction"
        ],
        "additionalProperties": false
      }
    },
    "extra_responders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ring_position": {
            "type": "integer",
            "minimum": 0
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "identity_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ring_position",
          "profile",
          "identity_key"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "family",
    "profile",
    "identity_key",
    "metres_per_motor_turn",
    "stroke_min_m",
    "stroke_max_m",
    "hard_stop_margin_m",
    "max_velocity_m_s",
    "axes"
  ],
  "additionalProperties": false
}
