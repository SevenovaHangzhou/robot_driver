{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "family": {
      "const": "kinco"
    },
    "assembly": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module_position": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "steering",
              "drive"
            ]
          },
          "robot_model_joint": {
            "type": "string",
            "minLength": 1
          },
          "ring_position": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "TBD"
              }
            ]
          },
          "device": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  -1,
                  1
                ]
              },
              {
                "const": "TBD"
              }
            ]
          },
          "mode_of_operation": {
            "enum": [
              8,
              9
            ]
          },
          "interface_contract": {
            "type": "string",
            "minLength": 1
          },
          "mock_joint_name": {
            "type": "string",
            "minLength": 1
          },
          "model_heading_sign": {
            "type": "integer",
            "enum": [
              -1,
              1
            ]
          }
        },
        "required": [
          "module_position",
          "role",
          "robot_model_joint",
          "ring_position",
          "device",
          "direction",
          "mode_of_operation",
          "interface_contract",
          "mock_joint_name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "family",
    "assembly",
    "profile",
    "axes"
  ],
  "additionalProperties": false
}
