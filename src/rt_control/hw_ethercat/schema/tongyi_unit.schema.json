{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "confirmed_by": {
      "type": "string",
      "minLength": 1
    },
    "captured_utc": {
      "type": "string"
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ring_position": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "TBD"
              }
            ]
          },
          "zero_counts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "const": "TBD"
              }
            ]
          }
        },
        "required": [
          "ring_position",
          "zero_counts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "confirmed_by",
    "axes"
  ],
  "additionalProperties": false
}
