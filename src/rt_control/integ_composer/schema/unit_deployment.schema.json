{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "unit deployment",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "module_envelope.schema.json#/definitions/schema_version"
    },
    "kind": {
      "$ref": "module_envelope.schema.json#/definitions/kind_unit_deployment"
    },
    "robot_variant": {
      "$ref": "module_envelope.schema.json#/definitions/robot_variant"
    },
    "status": {
      "$ref": "module_envelope.schema.json#/definitions/status"
    },
    "verified": {
      "$ref": "module_envelope.schema.json#/definitions/verified"
    },
    "authorities": {
      "$ref": "module_envelope.schema.json#/definitions/authorities"
    },
    "pending_facts": {
      "$ref": "module_envelope.schema.json#/definitions/pending_facts"
    },
    "end_effector": {
      "enum": [
        "gripper",
        "suction",
        "mobile_proxy"
      ]
    },
    "hardware_options": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "can_interfaces": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": "TBD"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ethercat": {
      "type": "object",
      "properties": {
        "master_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "TBD"
            }
          ]
        }
      },
      "required": [
        "master_id"
      ],
      "additionalProperties": false
    },
    "host_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "const": "TBD"
        }
      ]
    },
    "canopen": {
      "type": "object",
      "properties": {
        "master_node_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            },
            {
              "const": "TBD"
            }
          ]
        },
        "eds_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bitrate_kbps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 10
            },
            {
              "const": "TBD"
            }
          ]
        },
        "bundle_dir": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "const": "TBD"
            }
          ]
        }
      },
      "required": [
        "master_node_id",
        "eds_files"
      ],
      "additionalProperties": false
    },
    "runtime_log_recorder": {
      "description": "Optional Runtime-LOG 1 kHz recorder (runtime_log_recorder/RecorderController, built on the host from the Runtime-LOG repository). Loaded by its own non-fatal spawner after the lifecycle controllers.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "slots": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "ethercat_mac": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
        },
        "can_usb_serials": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "rt_cpu": {
          "type": "integer",
          "minimum": 0
        },
        "housekeeping_cpus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "hostname",
        "ethercat_mac",
        "rt_cpu",
        "housekeeping_cpus"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "robot_variant",
    "status",
    "verified",
    "authorities",
    "pending_facts",
    "end_effector",
    "hardware_options",
    "can_interfaces",
    "ethercat",
    "host_id"
  ],
  "additionalProperties": false
}
