{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "device_fault_table",
  "description": "Vendor fault codes of one drive series, transcribed from the vendor manual. Code meaning is vendor-defined, never derived from the bus protocol. Each fault maps to one company DREE event class (robot_interfaces ErrorCode.msg); the vendor code itself is reported in ErrorInfo.detail.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "status",
    "verified",
    "authorities",
    "pending_facts",
    "vendor",
    "read",
    "faults"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "device_fault_table"
    },
    "status": {
      "$ref": "module_envelope.schema.json#/definitions/status"
    },
    "verified": {
      "$ref": "module_envelope.schema.json#/definitions/verified"
    },
    "authorities": {
      "$ref": "module_envelope.schema.json#/definitions/authorities"
    },
    "pending_facts": {
      "$ref": "module_envelope.schema.json#/definitions/pending_facts"
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "read": {
      "type": "array",
      "minItems": 1,
      "description": "Objects that carry the vendor code: 'code' = one numeric code, 'bits' = one fault per set bit.",
      "items": {
        "type": "object",
        "required": [
          "object",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "pattern": "^0x[0-9A-F]{4}$"
          },
          "kind": {
            "enum": [
              "code",
              "bits"
            ]
          }
        }
      }
    },
    "faults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/fault"
      }
    }
  },
  "definitions": {
    "fault": {
      "type": "object",
      "required": [
        "message",
        "dree",
        "page"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{4}$",
          "description": "Value read from a 'code' object."
        },
        "object": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{4}$",
          "description": "A 'bits' object."
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "ds402": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{4}$",
          "description": "DS402 code the vendor lists for this bit."
        },
        "encoder": {
          "enum": [
            "incremental",
            "magnetic"
          ],
          "description": "Motor encoder type the vendor entry applies to."
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "dree": {
          "type": "string",
          "pattern": "^RT_[A-Z0-9_]+$"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "Printed page in the cited manual."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "code"
          ],
          "not": {
            "required": [
              "object"
            ]
          }
        },
        {
          "required": [
            "object",
            "bit"
          ],
          "not": {
            "required": [
              "code"
            ]
          }
        }
      ]
    }
  }
}
