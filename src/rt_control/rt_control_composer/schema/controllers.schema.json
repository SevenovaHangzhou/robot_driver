{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "controllers",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "module_envelope.schema.json#/definitions/schema_version"
    },
    "kind": {
      "$ref": "module_envelope.schema.json#/definitions/kind_controllers"
    },
    "robot_variant": {
      "$ref": "module_envelope.schema.json#/definitions/robot_variant"
    },
    "status": {
      "$ref": "module_envelope.schema.json#/definitions/status"
    },
    "verified": {
      "$ref": "module_envelope.schema.json#/definitions/verified"
    },
    "authorities": {
      "$ref": "module_envelope.schema.json#/definitions/authorities"
    },
    "pending_facts": {
      "$ref": "module_envelope.schema.json#/definitions/pending_facts"
    },
    "controllers": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "plugin": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "config_file": {
              "$ref": "module_envelope.schema.json#/definitions/share_path"
            },
            "actuator_groups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "required_state_modules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "parameters": {
              "type": "array",
              "description": "Ordered declarative sources; each item has exactly one source kind.",
              "items": {
                "type": "object",
                "properties": {
                  "when_policy": {
                    "type": "string",
                    "minLength": 1
                  },
                  "yaml": {
                    "type": "object",
                    "properties": {
                      "package": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file": {
                        "$ref": "module_envelope.schema.json#/definitions/share_path"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "package",
                      "file",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  "policy": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "overlay": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "keys_from": {
                        "type": "string",
                        "minLength": 1
                      },
                      "as": {
                        "type": "string",
                        "minLength": 1
                      },
                      "transform": {
                        "enum": [
                          "flatten",
                          "lengths"
                        ]
                      },
                      "match": {
                        "enum": [
                          "managed_joints",
                          "actuator_groups"
                        ]
                      },
                      "partition": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  "controllers": {
                    "type": "object",
                    "properties": {
                      "tag": {
                        "type": "string",
                        "minLength": 1
                      },
                      "select": {
                        "enum": [
                          "first",
                          "all",
                          "any"
                        ]
                      },
                      "default": {
                        "type": "string"
                      },
                      "as": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "tag",
                      "select",
                      "as"
                    ],
                    "additionalProperties": false
                  },
                  "owner_parameters": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  },
                  "topics": {
                    "type": "object",
                    "properties": {
                      "templates": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "templates"
                    ],
                    "additionalProperties": false
                  },
                  "runtime": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "enum": [
                          "startup_id"
                        ]
                      },
                      "as": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "key",
                      "as"
                    ],
                    "additionalProperties": false
                  },
                  "policy_file": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "as": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name",
                      "as"
                    ],
                    "additionalProperties": false
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "yaml"
                    ]
                  },
                  {
                    "required": [
                      "policy"
                    ]
                  },
                  {
                    "required": [
                      "controllers"
                    ]
                  },
                  {
                    "required": [
                      "owner_parameters"
                    ]
                  },
                  {
                    "required": [
                      "topics"
                    ]
                  },
                  {
                    "required": [
                      "runtime"
                    ]
                  },
                  {
                    "required": [
                      "policy_file"
                    ]
                  }
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "module",
            "name",
            "plugin",
            "package",
            "config_file",
            "actuator_groups",
            "required_state_modules"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "robot_variant",
    "status",
    "verified",
    "authorities",
    "pending_facts",
    "controllers"
  ],
  "additionalProperties": false
}
