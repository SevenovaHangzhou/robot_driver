diff --git a/joint_trajectory_controller/src/joint_trajectory_controller.cpp b/joint_trajectory_controller/src/joint_trajectory_controller.cpp
index 23aab7ba..5577412e 100644
--- a/joint_trajectory_controller/src/joint_trajectory_controller.cpp
+++ b/joint_trajectory_controller/src/joint_trajectory_controller.cpp
@@ -1688,6 +1688,20 @@ bool JointTrajectoryController::validate_trajectory_msg(
     return false;
   }
 
+  // The first update() after a new trajectory sorts and fills every point in the realtime
+  // thread (about 0.6 us per point on the bench IPC). Bound that work here, outside the loop.
+  if (
+    params_.max_trajectory_points > 0 &&
+    trajectory.points.size() > static_cast<size_t>(params_.max_trajectory_points))
+  {
+    RCLCPP_ERROR(
+      get_node()->get_logger(),
+      "Trajectory has %zu points, more than max_trajectory_points (%ld). Resample it to fewer "
+      "points (the controller interpolates between points) or split it into several goals.",
+      trajectory.points.size(), static_cast<long>(params_.max_trajectory_points));
+    return false;
+  }
+
   const auto trajectory_start_time = static_cast<rclcpp::Time>(trajectory.header.stamp);
   // If the starting time it set to 0.0, it means the controller should start it now.
   // Otherwise we check if the trajectory ends before the current time,
