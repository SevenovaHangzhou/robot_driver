+
+// Position range of the same cubic Hermite segment: its ends and the interior zeros of the
+// quadratic velocity.
+std::pair<double, double> hermite_position_range(
+  double q0, double v0, double q1, double v1, double duration)
+{
+  const double a = (2.0 * (q0 - q1) + (v0 + v1) * duration) / (duration * duration * duration);
+  const double b = (3.0 * (q1 - q0) - (2.0 * v0 + v1) * duration) / (duration * duration);
+  double lowest = std::min(q0, q1);
+  double highest = std::max(q0, q1);
+  const auto include = [&](double s)
+  {
+    if (std::isfinite(s) && s > 0.0 && s < duration)
+    {
+      const double position = ((a * s + b) * s + v0) * s + q0;
+      lowest = std::min(lowest, position);
+      highest = std::max(highest, position);
+    }
+  };
+  if (a == 0.0)
+  {
+    include(b == 0.0 ? 0.0 : -v0 / (2.0 * b));
+  }
+  else
+  {
+    const double discriminant = b * b - 3.0 * a * v0;
+    if (discriminant >= 0.0)
+    {
+      include((-b + std::sqrt(discriminant)) / (3.0 * a));
+      include((-b - std::sqrt(discriminant)) / (3.0 * a));
+    }
+  }
+  return {lowest, highest};
+}
