+TEST_F(TrajectoryControllerTest, position_limits_need_one_pair_per_joint)
+{
+  for (const auto & [lower, upper] :
+       {std::pair{std::vector<double>{0.0, 0.0, 0.0}, std::vector<double>{}},
+        std::pair{std::vector<double>{0.0, 0.0}, std::vector<double>{5.0, 5.0}},
+        std::pair{std::vector<double>{5.0, 0.0, 0.0}, std::vector<double>{5.0, 5.0, 5.0}}})
+  {
+    rclcpp::executors::MultiThreadedExecutor executor;
+    auto parameters = admission_parameters();
+    parameters.emplace_back("joint_position_limits_lower", lower);
+    parameters.emplace_back("joint_position_limits_upper", upper);
+    SetUpTrajectoryController(executor, parameters);
+    EXPECT_EQ(traj_controller_->get_node()->configure().id(), State::PRIMARY_STATE_UNCONFIGURED);
+    executor.cancel();
+  }
+}
+
+TEST_F(TrajectoryControllerTest, admission_rejects_points_and_segments_outside_position_limits)
+{
+  rclcpp::executors::MultiThreadedExecutor executor;
+  auto parameters = admission_parameters();
+  std::vector<double> lower;
+  std::vector<double> upper;
+  for (const double initial : INITIAL_POS_JOINTS)
+  {
+    lower.push_back(initial - 0.28);
+    upper.push_back(initial + 0.28);
+  }
+  parameters.emplace_back("joint_position_limits_lower", lower);
+  parameters.emplace_back("joint_position_limits_upper", upper);
+  SetUpAndActivateTrajectoryController(executor, parameters);
+  updateController(rclcpp::Duration::from_seconds(0.02));
+
+  EXPECT_TRUE(
+    traj_controller_->validate_trajectory_start(offsets(joint_names_, {{2.0, 0.25}, {4.0, 0.25}})));
+  EXPECT_FALSE(traj_controller_->validate_trajectory_start(offsets(joint_names_, {{2.0, 0.29}})));
+  EXPECT_FALSE(traj_controller_->validate_trajectory_start(offsets(joint_names_, {{2.0, -0.29}})));
+  // Both points lie inside, but at 0.3 rad/s the cubic between them peaks near +0.308 rad.
+  EXPECT_FALSE(traj_controller_->validate_trajectory_start(
+    offsets(joint_names_, {{2.0, 0.25}, {4.0, 0.25}}, 0.3)));
+  executor.cancel();
+}
