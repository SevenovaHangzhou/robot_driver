+bool JointTrajectoryController::validate_trajectory_velocities(
+  const trajectory_msgs::msg::JointTrajectory & trajectory) const
+{
+  for (size_t goal_index = 0; goal_index < trajectory.joint_names.size(); ++goal_index)
+  {
+    const auto joint =
+      std::find(params_.joints.begin(), params_.joints.end(), trajectory.joint_names[goal_index]);
+    const double limit =
+      params_
+        .joint_velocity_limits[static_cast<size_t>(std::distance(params_.joints.begin(), joint))];
+    for (size_t point = 0; point < trajectory.points.size(); ++point)
+    {
+      const auto & current = trajectory.points[point];
+      double velocity = current.velocities.empty() ? 0.0 : std::abs(current.velocities[goal_index]);
+      const char * reason = "point_velocity";
+      if (point > 0)
+      {
+        const auto & previous = trajectory.points[point - 1];
+        const double average =
+          std::abs(current.positions[goal_index] - previous.positions[goal_index]) /
+          (rclcpp::Duration(current.time_from_start) - rclcpp::Duration(previous.time_from_start))
+            .seconds();
+        if (average > velocity)
+        {
+          velocity = average;
+          reason = "segment_velocity";
+        }
+      }
+      if (!std::isfinite(velocity) || velocity > limit)
+      {
+        RCLCPP_ERROR(
+          get_node()->get_logger(),
+          "FJT_REJECT reason=%s joint=%s point=%zu velocity=%.17g limit=%.17g", reason,
+          trajectory.joint_names[goal_index].c_str(), point, velocity, limit);
+        return false;
+      }
+    }
+  }
+  return true;
+}
