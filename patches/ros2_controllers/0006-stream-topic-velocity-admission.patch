+TEST_F(TestTrajectoryActions, topic_trajectory_aborts_the_active_goal)
+{
+  SetUpExecutor();
+  SetUpControllerHardware();
+
+  std::vector<JointTrajectoryPoint> points(2);
+  for (size_t index = 0; index < points.size(); ++index)
+  {
+    points[index].time_from_start = rclcpp::Duration::from_seconds(0.5 + 0.5 * index);
+    points[index].positions = {1.0 + 0.1 * index, 2.0, 3.0};
+  }
+  auto goal = sendActionGoal(points, 1.0, goal_options_);
+  ASSERT_EQ(std::future_status::ready, goal.wait_for(std::chrono::seconds(1)));
+
+  // The newest command wins; the goal must not report on a trajectory it no longer owns.
+  trajectory_msgs::msg::JointTrajectory stream;
+  stream.joint_names = joint_names_;
+  stream.points = points;
+  trajectory_publisher_->publish(stream);
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+  while (common_resultcode_ == rclcpp_action::ResultCode::UNKNOWN &&
+         std::chrono::steady_clock::now() < deadline)
+  {
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  EXPECT_EQ(rclcpp_action::ResultCode::ABORTED, common_resultcode_);
+  EXPECT_EQ(
+    control_msgs::action::FollowJointTrajectory_Result::INVALID_GOAL, common_action_result_code_);
+}
