+TEST(MaintainDataTest, StartupAndHandoffExchangeAllDomainsOncePerCycle)
+{
+  calls.clear();
+  ObservedSlave left, sensor;
+  EcMaster master;
+  EcMasterHandoffTestAccess::addDomain(master, left, 1);
+  EcMasterHandoffTestAccess::addDomain(master, sensor, 4);
+  master.update();
+  EXPECT_EQ(left.interface_updates, 1);
+  EXPECT_EQ(sensor.interface_updates, 1);
+  EXPECT_EQ(std::count(calls.begin(), calls.end(), "send"), 1);
+  calls.clear();
+  ASSERT_TRUE(master.maintainData());
+  EXPECT_EQ(left.interface_updates, 1);
+  EXPECT_EQ(sensor.interface_updates, 1);
+  EXPECT_EQ(std::count(calls.begin(), calls.end(), "process"), 2);
+  EXPECT_EQ(std::count(calls.begin(), calls.end(), "queue"), 2);
+  EXPECT_EQ(std::count(calls.begin(), calls.end(), "send"), 1);
+  receive_failure = true;
+  master.readData();
+  receive_failure = false;
+  EXPECT_FALSE(master.domainComplete(1));
+  EXPECT_FALSE(master.domainComplete(4));
+}
