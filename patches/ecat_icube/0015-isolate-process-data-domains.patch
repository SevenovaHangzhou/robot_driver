+TEST(MaintainDataTest, SensorDomainFailureDoesNotInvalidateMotorDomains)
+{
+  calls.clear();
+  ObservedSlave left, right, sensor;
+  EcMaster master;
+  EcMasterHandoffTestAccess::addDomain(master, left, 1);
+  EcMasterHandoffTestAccess::addDomain(master, right, 2);
+  EcMasterHandoffTestAccess::addDomain(master, sensor, 3);
+  incomplete_domain = 4;
+  master.readData();
+  EXPECT_TRUE(left.read_valid);
+  EXPECT_TRUE(right.read_valid);
+  EXPECT_FALSE(sensor.read_valid);
+  EXPECT_TRUE(std::isfinite(master.processDataAgeMs(1)));
+  EXPECT_TRUE(std::isfinite(master.processDataAgeMs(2)));
+  EXPECT_FALSE(std::isfinite(master.processDataAgeMs(3)));
+  EXPECT_FALSE(std::isfinite(master.processDataAgeMs()));
+  EXPECT_FALSE(master.domainComplete(3));
+  master.writeData();
+  EXPECT_TRUE(left.write_valid);
+  EXPECT_TRUE(right.write_valid);
+  EXPECT_FALSE(sensor.write_valid);
+  EXPECT_EQ(std::count(calls.begin(), calls.end(), "receive"), 1);
+  EXPECT_EQ(std::count(calls.begin(), calls.end(), "process"), 3);
+  EXPECT_EQ(std::count(calls.begin(), calls.end(), "queue"), 3);
+  EXPECT_EQ(std::count(calls.begin(), calls.end(), "send"), 1);
+  EXPECT_EQ(left.acknowledgements, 1);
+  EXPECT_EQ(sensor.acknowledgements, 1);
+  // A motor domain failure remains visible even if the sensor recovers.
+  incomplete_domain = 2;
+  master.readData();
+  EXPECT_FALSE(left.read_valid);
+  EXPECT_TRUE(sensor.read_valid);
+  EXPECT_FALSE(master.domainComplete(1));
+  EXPECT_TRUE(master.domainComplete(3));
+}
