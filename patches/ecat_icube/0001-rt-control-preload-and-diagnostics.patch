+
+  uint8_t control_word[2]{};
+  plugin_->processData(1, control_word);
+  ASSERT_EQ(EC_READ_U16(control_word), 0x0007);
+
+  uint8_t status_word[2]{};
+  EC_WRITE_U16(status_word, 0x0023);
+  plugin_->processData(3, status_word);
+  uint8_t actual_position[4]{};
+  EC_WRITE_S32(actual_position, 123456);
+  plugin_->processData(2, actual_position);
+
+  uint8_t target_position[4]{};
+  plugin_->processData(0, target_position);
+  ASSERT_EQ(EC_READ_S32(target_position), 123456);
+  ASSERT_FALSE(plugin_->target_position_preloaded_);
+  plugin_->processData(1, control_word);
+  ASSERT_EQ(EC_READ_U16(control_word), 0x0007);
+  plugin_->onPdoCycleSent();
+  ASSERT_TRUE(plugin_->target_position_preloaded_);
+  ASSERT_TRUE(plugin_->initialized());
+
+  plugin_->processData(1, control_word);
+  ASSERT_EQ(EC_READ_U16(control_word), 0x000F);
+}
+
+TEST_F(EcCiA402DriveTest, LeavingOperationEnabledClearsSessionState)
+{
+  std::vector<double> state_interface = {0.0, 0.0};
+  std::vector<double> command_interface = {0.0, 0x000F};
+  plugin_->state_interface_ptr_ = &state_interface;
+  plugin_->command_interface_ptr_ = &command_interface;
+  plugin_->paramters_ = {
+    {"state_interface/position", "0"},
+    {"state_interface/status_word", "1"},
+    {"command_interface/position", "0"},
+    {"command_interface/control_word", "1"}};
+  ASSERT_TRUE(plugin_->setup_from_config(YAML::Load(scaled_preload_drive_config)));
+  plugin_->setup_interface_mapping();
+  plugin_->position_command_interface_index_ = 0;
+  plugin_->is_operational_ = true;
+
+  uint8_t actual_position[4]{};
+  EC_WRITE_S32(actual_position, 262144);
+  plugin_->status_word_ = 0x0023;
+  plugin_->processData(2, actual_position);
+  uint8_t target_position[4]{};
+  plugin_->processData(0, target_position);
+  plugin_->state_ = STATE_OPERATION_ENABLED;
+  plugin_->last_state_ = STATE_OPERATION_ENABLED;
+  plugin_->position_command_takeover_allowed_ = true;
+  plugin_->position_command_synchronized_ = true;
+
+  uint8_t status_word[2]{};
+  EC_WRITE_U16(status_word, 0x0040);
+  plugin_->processData(3, status_word);
+  uint8_t last_channel[4]{};
+  plugin_->processData(plugin_->all_channels_.size() - 1, last_channel);
+
+  ASSERT_FALSE(plugin_->target_position_preloaded_);
+  ASSERT_FALSE(plugin_->position_command_takeover_allowed_);
+  ASSERT_FALSE(plugin_->position_command_synchronized_);
+  ASSERT_TRUE(std::isnan(command_interface[0]));
+}
