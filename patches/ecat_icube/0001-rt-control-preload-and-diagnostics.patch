+EthercatDriver::StateInterfaceBinding EthercatDriver::findSensorStateInterface(
+  const std::string & sensor_name, const std::string & interface_name) const
+{
+  for (size_t sensor = 0; sensor < info_.sensors.size(); ++sensor) {
+    if (info_.sensors[sensor].name != sensor_name) {
+      continue;
+    }
+    for (size_t interface = 0;
+      interface < info_.sensors[sensor].state_interfaces.size(); ++interface)
+    {
+      if (info_.sensors[sensor].state_interfaces[interface].name == interface_name) {
+        return StateInterfaceBinding{sensor, interface};
+      }
+    }
+  }
+  return StateInterfaceBinding{};
+}
+
+void EthercatDriver::setSensorState(
+  const StateInterfaceBinding & binding, double value)
+{
+  if (binding.valid()) {
+    hw_sensor_states_[binding.component][binding.interface] = value;
+  }
+}
+
+void EthercatDriver::updateDiagnosticStateInterfaces()
+{
+  setSensorState(process_data_age_binding_, master_.processDataAgeMs());
+  setSensorState(link_up_binding_, master_.linkUp() ? 1.0 : 0.0);
+  setSensorState(slaves_responding_binding_, master_.slavesResponding());
+  setSensorState(working_counter_error_binding_, master_.workingCounterErrorCount());
+  const size_t slave_count = std::min(
+    master_.configuredSlaveCount(), slave_al_state_bindings_.size());
+  for (size_t slave = 0; slave < slave_count; ++slave) {
+    setSensorState(slave_al_state_bindings_[slave], master_.slaveAlState(slave));
+  }
+}
