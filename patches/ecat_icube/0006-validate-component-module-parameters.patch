diff --git a/ethercat_driver/test/test_ec_module_parameters.cpp b/ethercat_driver/test/test_ec_module_parameters.cpp
new file mode 100644
index 0000000..6ce370d
--- /dev/null
+++ b/ethercat_driver/test/test_ec_module_parameters.cpp
@@ -0,0 +1,159 @@
+#include <gtest/gtest.h>
+
+#include <array>
+#include <cstdint>
+#include <exception>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include "ethercat_driver/ethercat_driver.hpp"
+#include "hardware_interface/hardware_info.hpp"
+
+namespace ethercat_driver
+{
+
+class EthercatDriverTestAccess
+{
+public:
+  static std::vector<std::unordered_map<std::string, std::string>> moduleParameters(
+    const hardware_interface::ComponentInfo & component)
+  {
+    return EthercatDriver::getEcModuleParam(component);
+  }
+};
+
+namespace
+{
+
+hardware_interface::ComponentInfo makeComponent()
+{
+  hardware_interface::ComponentInfo component;
+  component.name = "axis";
+  component.type = "joint";
+  component.parameters = {
+    {"ec_module.name", "axis_drive"},
+    {"ec_module.plugin", "ethercat_generic_plugins/EcCiA402Drive"},
+    {"ec_module.alias", "0"},
+    {"ec_module.position", "15"},
+    {"ec_module.mode_of_operation", "8"},
+    {"ec_module.slave_config", "/config/slaves/axis.yaml"},
+    {"unrelated", "preserved outside the EtherCAT module"},
+  };
+  return component;
+}
+
+TEST(EcModuleParametersTest, StripsTheNamespaceAndPreservesRuntimeValues)
+{
+  const auto modules = EthercatDriverTestAccess::moduleParameters(makeComponent());
+
+  ASSERT_EQ(modules.size(), 1U);
+  EXPECT_EQ(
+    modules.front(),
+    (std::unordered_map<std::string, std::string>{
+      {"name", "axis_drive"},
+      {"plugin", "ethercat_generic_plugins/EcCiA402Drive"},
+      {"alias", "0"},
+      {"position", "15"},
+      {"mode_of_operation", "8"},
+      {"slave_config", "/config/slaves/axis.yaml"},
+    }));
+}
+
+TEST(EcModuleParametersTest, CanonicalizesNumericValuesBeforeAddressComparison)
+{
+  auto component = makeComponent();
+  component.parameters["ec_module.alias"] = "000";
+  component.parameters["ec_module.position"] = "0015";
+  component.parameters["ec_module.mode_of_operation"] = "008";
+
+  const auto modules = EthercatDriverTestAccess::moduleParameters(component);
+
+  ASSERT_EQ(modules.size(), 1U);
+  EXPECT_EQ(modules.front().at("alias"), "0");
+  EXPECT_EQ(modules.front().at("position"), "15");
+  EXPECT_EQ(modules.front().at("mode_of_operation"), "8");
+}
+
+TEST(EcModuleParametersTest, AllowsComponentsWithoutAnEthercatModule)
+{
+  hardware_interface::ComponentInfo sensor;
+  sensor.name = "diagnostic_sensor";
+  sensor.type = "sensor";
+  sensor.parameters = {{"initial_value", "0.0"}};
+
+  EXPECT_TRUE(EthercatDriverTestAccess::moduleParameters(sensor).empty());
+}
+
+TEST(EcModuleParametersTest, RejectsMissingOrEmptyRequiredValues)
+{
+  const std::array<const char *, 5> required{
+    "name", "plugin", "alias", "position", "slave_config"};
+  for (const char * name : required) {
+    auto missing = makeComponent();
+    missing.parameters.erase(std::string("ec_module.") + name);
+    EXPECT_THROW(EthercatDriverTestAccess::moduleParameters(missing), std::runtime_error) << name;
+
+    auto empty = makeComponent();
+    empty.parameters[std::string("ec_module.") + name].clear();
+    EXPECT_THROW(EthercatDriverTestAccess::moduleParameters(empty), std::runtime_error) << name;
+  }
+}
+
+TEST(EcModuleParametersTest, RequiresModeForCia402DriveModules)
+{
+  auto component = makeComponent();
+  component.parameters.erase("ec_module.mode_of_operation");
+
+  EXPECT_THROW(EthercatDriverTestAccess::moduleParameters(component), std::runtime_error);
+}
+
+TEST(EcModuleParametersTest, AllowsOtherPluginTypesWithoutCia402Mode)
+{
+  auto component = makeComponent();
+  component.parameters["ec_module.plugin"] = "example/NonCia402Module";
+  component.parameters.erase("ec_module.mode_of_operation");
+
+  const auto modules = EthercatDriverTestAccess::moduleParameters(component);
+
+  ASSERT_EQ(modules.size(), 1U);
+  EXPECT_EQ(modules.front().at("plugin"), "example/NonCia402Module");
+  EXPECT_EQ(modules.front().count("mode_of_operation"), 0U);
+}
+
+class InvalidNumericEcModuleParameterTest :
+  public ::testing::TestWithParam<std::pair<std::string, std::string>>
+{};
+
+TEST_P(InvalidNumericEcModuleParameterTest, RejectsMalformedOrOutOfRangeValues)
+{
+  auto component = makeComponent();
+  const auto & [parameter, value] = GetParam();
+  component.parameters["ec_module." + parameter] = value;
+
+  EXPECT_THROW(EthercatDriverTestAccess::moduleParameters(component), std::exception);
+}
+
+INSTANTIATE_TEST_SUITE_P(
+  InvalidNumbers, InvalidNumericEcModuleParameterTest,
+  ::testing::Values(
+    std::make_pair("alias", "-1"),
+    std::make_pair("alias", "1.0"),
+    std::make_pair("alias", "1junk"),
+    std::make_pair("alias", "65536"),
+    std::make_pair("position", "-1"),
+    std::make_pair("position", "65536"),
+    std::make_pair("mode_of_operation", "2"),
+    std::make_pair("mode_of_operation", "5"),
+    std::make_pair("mode_of_operation", "-1"),
+    std::make_pair("mode_of_operation", "1.5"),
+    std::make_pair("mode_of_operation", "11"),
+    std::make_pair("mode_of_operation", "127"),
+    std::make_pair("mode_of_operation", "128"),
+    std::make_pair("mode_of_operation", "255"),
+    std::make_pair("mode_of_operation", "256")));
+
+}  // namespace
+}  // namespace ethercat_driver
