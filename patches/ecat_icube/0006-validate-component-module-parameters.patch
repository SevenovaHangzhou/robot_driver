+template<typename Integer>
+void validateUnsignedParameter(
+  const std::unordered_map<std::string, std::string> & parameters,
+  const char * parameter_name,
+  const std::string & component_name)
+{
+  const std::string & value = parameters.at(parameter_name);
+  if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos) {
+    throw std::invalid_argument(
+            "EtherCAT module parameter " + std::string(parameter_name) +
+            " for component " + component_name + " must be an unsigned integer");
+  }
+  std::size_t parsed_characters = 0U;
+  const auto parsed = std::stoul(value, &parsed_characters, 10);
+  if (parsed_characters != value.size() || parsed > std::numeric_limits<Integer>::max()) {
+    throw std::out_of_range(
+            "EtherCAT module parameter " + std::string(parameter_name) +
+            " for component " + component_name + " is outside its valid range");
+  }
+}
 }
 
