+
+TEST(TestEcPdoChannelManager, MirrorsTheValueActuallySent)
+{
+  const char channel_config[] =
+    R"(
+      {index: 0x607A, sub_index: 0, type: int32, command_interface: position,
+       mirror_state_interface: target_position, default: .nan, factor: 2, offset: 10}
+    )";
+  YAML::Node config = YAML::Load(channel_config);
+  ethercat_interface::EcPdoChannelManager pdo_manager;
+  pdo_manager.pdo_type = ethercat_interface::PdoType::RPDO;
+  pdo_manager.load_from_config(config);
+  ASSERT_EQ(pdo_manager.mirror_interface_name, "target_position");
+
+  const double nan = std::numeric_limits<double>::quiet_NaN();
+  std::vector<double> state_interfaces = {nan, nan};
+  std::vector<double> command_interfaces = {1.3};
+  pdo_manager.setup_interface_ptrs(&state_interfaces, &command_interfaces);
+  pdo_manager.interface_index = 0;
+  pdo_manager.mirror_interface_index = 1;
+  uint8_t domain[8] = {0};
+
+  // 2 * 1.3 + 10 = 12.6 is written as int32 12: the mirror reports what the frame carries.
+  pdo_manager.ec_update(domain);
+  EXPECT_EQ(EC_READ_S32(domain), 12);
+  EXPECT_DOUBLE_EQ(state_interfaces[1], 1.0);
+
+  // No command and no default: nothing is written, the frame keeps 12.
+  command_interfaces[0] = nan;
+  pdo_manager.ec_update(domain);
+  EXPECT_DOUBLE_EQ(state_interfaces[1], 1.0);
+
+  // A plugin override (e.g. holding the preloaded position) is mirrored as well.
+  pdo_manager.override_command = true;
+  pdo_manager.default_value = 30;
+  pdo_manager.ec_update(domain);
+  EXPECT_DOUBLE_EQ(state_interfaces[1], 10.0);
+
+  // Unmapped mirror: nothing touched.
+  pdo_manager.mirror_interface_index = -1;
+  state_interfaces[1] = -1.0;
+  pdo_manager.ec_update(domain);
+  EXPECT_DOUBLE_EQ(state_interfaces[1], -1.0);
+}
