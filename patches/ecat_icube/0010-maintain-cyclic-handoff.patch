+namespace
+{
+std::vector<std::string> calls;
+std::array<uint8_t, 8> image{6, 0, 42, 0, 0, 0, 0, 0};
+uint64_t app_time = 0;
+bool receive_failure = false;
+}
+
+extern "C"
+{
+ec_master_t * __wrap_ecrt_request_master(unsigned int)
+{return reinterpret_cast<ec_master_t *>(1);}
+void __wrap_ecrt_release_master(ec_master_t *) {}
+ec_domain_t * __wrap_ecrt_master_create_domain(ec_master_t *)
+{return reinterpret_cast<ec_domain_t *>(2);}
+int __wrap_ecrt_master_receive(ec_master_t *)
+{calls.emplace_back("receive"); return receive_failure ? -1 : 0;}
+int __wrap_ecrt_domain_process(ec_domain_t *) {calls.emplace_back("process"); return 0;}
+int __wrap_ecrt_domain_state(const ec_domain_t *, ec_domain_state_t * state)
+{*state = {}; state->working_counter = 48; state->wc_state = EC_WC_COMPLETE; return 0;}
+int __wrap_ecrt_master_state(const ec_master_t *, ec_master_state_t * state)
+{*state = {}; state->link_up = 1; state->slaves_responding = 18; return 0;}
+int __wrap_ecrt_master_application_time(ec_master_t *, uint64_t time)
+{app_time = time; calls.emplace_back("application_time"); return 0;}
+int __wrap_ecrt_master_sync_reference_clock(ec_master_t *) {calls.emplace_back("reference"); return 0;}
+int __wrap_ecrt_master_sync_slave_clocks(ec_master_t *) {calls.emplace_back("slaves"); return 0;}
+int __wrap_ecrt_domain_queue(ec_domain_t *) {calls.emplace_back("queue"); return 0;}
+int __wrap_ecrt_master_send(ec_master_t *) {calls.emplace_back("send"); return 0;}
+}
+
+namespace ethercat_interface
+{
+class EcMasterHandoffTestAccess
+{
+public:
+  static void addDomain(EcMaster & master, EcSlave & slave)
+  {
+    auto domain = new EcMaster::DomainInfo(master.master_);
+    domain->domain_pd = image.data();
+    EcMaster::DomainInfo::Entry entry;
+    entry.slave = &slave;
+    entry.num_pdos = 1;
+    entry.offset = new uint32_t[1]{0};
+    domain->entries.push_back(entry);
+    master.domain_info_.emplace(0, domain);
+  }
+};
+
+class ObservedSlave : public EcSlave
+{
+public:
+  ObservedSlave() : EcSlave(0, 0) {}
+  void processData(size_t, uint8_t *) override {++interface_updates;}
+  void onPdoCycleSent() override {++acknowledgements;}
+  int interface_updates = 0;
+  int acknowledgements = 0;
+};
+
+TEST(MaintainDataTest, ExchangesRawImageAndDcWithoutChangingCommandsOrInterfaces)
+{
+  calls.clear();
+  app_time = 0;
+  const auto original_image = image;
+  ObservedSlave slave;
+  EcMaster master;
+  EcMasterHandoffTestAccess::addDomain(master, slave);
+  ASSERT_TRUE(master.maintainData());
+  EXPECT_EQ(calls, (std::vector<std::string>{
+    "receive", "process", "application_time", "reference", "slaves", "queue", "send"}));
+  EXPECT_GT(app_time, 0U);
+  EXPECT_EQ(image, original_image);
+  EXPECT_EQ(slave.interface_updates, 0);
+  EXPECT_EQ(slave.acknowledgements, 0);
+  EXPECT_TRUE(std::isfinite(master.processDataAgeMs()));
+}
+
+TEST(MaintainDataTest, ReadFailureDoesNotSendOrUpdateInterfaces)
+{
+  calls.clear();
+  ObservedSlave slave;
+  EcMaster master;
+  EcMasterHandoffTestAccess::addDomain(master, slave);
+  receive_failure = true;
+  EXPECT_FALSE(master.maintainData());
+  receive_failure = false;
+  EXPECT_EQ(calls, (std::vector<std::string>{"receive"}));
+  EXPECT_EQ(slave.interface_updates, 0);
+}
