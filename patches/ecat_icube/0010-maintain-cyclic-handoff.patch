+// SPDX-License-Identifier: Apache-2.0
+#ifndef ETHERCAT_DRIVER__CYCLIC_HANDOFF_HPP_
+#define ETHERCAT_DRIVER__CYCLIC_HANDOFF_HPP_
+
+#include <atomic>
+#include <cstdint>
+
+namespace ethercat_driver
+{
+class CyclicHandoff
+{
+public:
+  void reset(bool enabled) noexcept
+  {
+    state_.store(enabled ? State::Idle : State::Control, std::memory_order_release);
+  }
+
+  bool beginMaintenance() noexcept
+  {
+    auto expected = State::Idle;
+    return state_.compare_exchange_strong(
+      expected, State::Busy, std::memory_order_acq_rel, std::memory_order_acquire);
+  }
+
+  void finishMaintenance() noexcept
+  {
+    auto expected = State::Busy;
+    if (!state_.compare_exchange_strong(
+        expected, State::Idle, std::memory_order_release, std::memory_order_relaxed) &&
+      expected == State::Requested)
+    {
+      state_.compare_exchange_strong(
+        expected, State::Released, std::memory_order_release, std::memory_order_relaxed);
+    }
+  }
+
+  bool claimControl() noexcept
+  {
+    auto expected = state_.load(std::memory_order_acquire);
+    if (expected == State::Control) {
+      return true;
+    }
+    if (expected == State::Idle || expected == State::Released) {
+      return state_.compare_exchange_strong(
+        expected, State::Control, std::memory_order_acq_rel, std::memory_order_acquire);
+    }
+    if (expected == State::Busy) {
+      state_.compare_exchange_strong(
+        expected, State::Requested, std::memory_order_acq_rel, std::memory_order_acquire);
+    }
+    return false;
+  }
+
+  void failMaintenance() noexcept
+  {
+    auto expected = State::Busy;
+    if (!state_.compare_exchange_strong(
+        expected, State::Failed, std::memory_order_release, std::memory_order_relaxed) &&
+      expected == State::Requested)
+    {
+      state_.compare_exchange_strong(
+        expected, State::Failed, std::memory_order_release, std::memory_order_relaxed);
+    }
+  }
+
+  bool controlOwns() const noexcept
+  {
+    return state_.load(std::memory_order_acquire) == State::Control;
+  }
+  bool failed() const noexcept
+  {
+    return state_.load(std::memory_order_acquire) == State::Failed;
+  }
+  bool stopped() const noexcept
+  {
+    return state_.load(std::memory_order_acquire) == State::Stopped;
+  }
+  void cancel() noexcept {state_.store(State::Stopped, std::memory_order_release);}
+
+private:
+  enum class State : uint8_t {Idle, Busy, Requested, Released, Control, Failed, Stopped};
+  static_assert(std::atomic<State>::is_always_lock_free, "handoff requires lock-free atomics");
+  std::atomic<State> state_{State::Stopped};
+};
+}  // namespace ethercat_driver
+
+#endif  // ETHERCAT_DRIVER__CYCLIC_HANDOFF_HPP_
