+
+void EthercatDriver::startHandoff(timespec next_cycle, int timeout_ms)
+{
+  const auto interval = master_.getInterval();
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+  std::promise<void> ready;
+  auto started = ready.get_future();
+  handoff_thread_ = std::thread(
+    [this, next_cycle, interval, deadline, ready = std::move(ready)]() mutable {
+      bool announced = false;
+      try {
+        const int name_error = pthread_setname_np(pthread_self(), "ecat-handoff");
+        if (name_error != 0) {
+          throw std::system_error(name_error, std::generic_category(), "Name cyclic handoff thread");
+        }
+        StartupRealtime scheduling;
+        if (!scheduling.enabled()) {
+          throw std::runtime_error("Cyclic handoff requires explicit startup CPU and priority");
+        }
+        ready.set_value();
+        announced = true;
+        while (handoff_.beginMaintenance()) {
+          if (std::chrono::steady_clock::now() >= deadline) {
+            throw std::runtime_error("Controller did not take cyclic ownership before the preload timeout");
+          }
+          int sleep_error;
+          do {
+            sleep_error = clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &next_cycle, nullptr);
+          } while (sleep_error == EINTR && !handoff_.stopped() &&
+            std::chrono::steady_clock::now() < deadline);
+          if (handoff_.stopped()) {
+            break;
+          }
+          if (sleep_error != 0) {
+            throw std::system_error(sleep_error, std::generic_category(), "Sleep cyclic handoff thread");
+          }
+          if (!master_.maintainData()) {
+            throw std::runtime_error("EtherCAT I/O failed during cyclic handoff");
+          }
+          handoff_.finishMaintenance();
+
+          timespec now{};
+          clock_gettime(CLOCK_MONOTONIC, &now);
+          next_cycle.tv_nsec += interval;
+          if (next_cycle.tv_nsec >= 1000000000L) {
+            next_cycle.tv_nsec -= 1000000000L;
+            ++next_cycle.tv_sec;
+          }
+          // A delayed wakeup must not produce a burst of catch-up PDO frames.
+          if (next_cycle.tv_sec < now.tv_sec ||
+            (next_cycle.tv_sec == now.tv_sec && next_cycle.tv_nsec <= now.tv_nsec))
+          {
+            next_cycle = now;
+            next_cycle.tv_nsec += interval;
+            if (next_cycle.tv_nsec >= 1000000000L) {
+              next_cycle.tv_nsec -= 1000000000L;
+              ++next_cycle.tv_sec;
+            }
+          }
+        }
+      } catch (const std::exception & error) {
+        handoff_.failMaintenance();
+        if (!announced) {
+          ready.set_exception(std::current_exception());
+        }
+        std::fprintf(stderr, "EtherCAT cyclic handoff failed: %s\n", error.what());
+      }
+    });
+  if (started.wait_until(deadline) != std::future_status::ready) {
+    stopHandoff();
+    throw std::runtime_error("Cyclic handoff thread did not start before the preload timeout");
+  }
+  started.get();
+}
+
+void EthercatDriver::stopHandoff()
+{
+  handoff_.cancel();
+  if (handoff_thread_.joinable()) {
+    handoff_thread_.join();
+  }
+}
+
+void EthercatDriver::exportSendTrace()
+{
+  if (!trace_exported_ && !send_trace_path_.empty()) {
+    trace_exported_ = true;
+    if (!master_.writeSendTrace(send_trace_path_)) {
+      RCLCPP_WARN(rclcpp::get_logger("EthercatDriver"), "Failed to export EtherCAT send trace");
+    }
+  }
+}
