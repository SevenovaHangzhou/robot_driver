diff --git a/ethercat_driver/test/test_cyclic_handoff.cpp b/ethercat_driver/test/test_cyclic_handoff.cpp
new file mode 100644
index 0000000..ddb5b01
--- /dev/null
+++ b/ethercat_driver/test/test_cyclic_handoff.cpp
@@ -0,0 +1,116 @@
+#include <gtest/gtest.h>
+
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "ethercat_driver/cyclic_handoff.hpp"
+
+using ethercat_driver::CyclicHandoff;
+
+TEST(CyclicHandoffTest, KeepsSendingDuringControllerConstruction)
+{
+  CyclicHandoff handoff;
+  handoff.reset(true);
+  std::vector<int> sends{0};
+  for (int milliseconds = 4; milliseconds <= 68; milliseconds += 4) {
+    ASSERT_TRUE(handoff.beginMaintenance());
+    sends.push_back(milliseconds);
+    handoff.finishMaintenance();
+  }
+  ASSERT_TRUE(handoff.claimControl());
+  sends.push_back(72);
+  EXPECT_TRUE(handoff.controlOwns());
+  EXPECT_FALSE(handoff.beginMaintenance());
+  for (size_t i = 1; i < sends.size(); ++i) {
+    EXPECT_EQ(sends[i] - sends[i - 1], 4);
+  }
+}
+
+TEST(CyclicHandoffTest, BusyCycleFinishesBeforeControllerCanAccessData)
+{
+  CyclicHandoff handoff;
+  handoff.reset(true);
+  ASSERT_TRUE(handoff.beginMaintenance());
+  EXPECT_FALSE(handoff.claimControl());
+  EXPECT_FALSE(handoff.controlOwns());
+  EXPECT_FALSE(handoff.claimControl());
+  handoff.finishMaintenance();
+  EXPECT_FALSE(handoff.controlOwns());
+  EXPECT_FALSE(handoff.beginMaintenance());
+  EXPECT_TRUE(handoff.claimControl());
+  EXPECT_TRUE(handoff.controlOwns());
+}
+
+TEST(CyclicHandoffTest, CancellationCannotBeOverwrittenByAnInFlightCycle)
+{
+  CyclicHandoff handoff;
+  handoff.reset(true);
+  ASSERT_TRUE(handoff.beginMaintenance());
+  handoff.cancel();
+  handoff.finishMaintenance();
+  EXPECT_TRUE(handoff.stopped());
+  EXPECT_FALSE(handoff.claimControl());
+  EXPECT_FALSE(handoff.beginMaintenance());
+}
+
+TEST(CyclicHandoffTest, FailedOrExpiredMaintenanceNeverAuthorizesControl)
+{
+  for (bool request_takeover : {false, true}) {
+    CyclicHandoff handoff;
+    handoff.reset(true);
+    ASSERT_TRUE(handoff.beginMaintenance());
+    if (request_takeover) {
+      EXPECT_FALSE(handoff.claimControl());
+    }
+    handoff.failMaintenance();
+    EXPECT_TRUE(handoff.failed());
+    EXPECT_FALSE(handoff.claimControl());
+    EXPECT_FALSE(handoff.controlOwns());
+    EXPECT_FALSE(handoff.beginMaintenance());
+  }
+}
+
+TEST(CyclicHandoffTest, DisabledExperimentRetainsDirectControllerOwnership)
+{
+  CyclicHandoff handoff;
+  handoff.reset(false);
+  EXPECT_TRUE(handoff.claimControl());
+  EXPECT_TRUE(handoff.controlOwns());
+  EXPECT_FALSE(handoff.beginMaintenance());
+}
+
+TEST(CyclicHandoffTest, CompletionPublishesDataAcrossThreads)
+{
+  CyclicHandoff handoff;
+  handoff.reset(true);
+  std::mutex mutex;
+  std::condition_variable condition;
+  bool entered = false;
+  bool requested = false;
+  int payload = 0;
+  std::thread producer([&]() {
+    EXPECT_TRUE(handoff.beginMaintenance());
+    {
+      std::unique_lock<std::mutex> lock(mutex);
+      entered = true;
+      condition.notify_one();
+      condition.wait(lock, [&]() {return requested;});
+    }
+    payload = 42;
+    handoff.finishMaintenance();
+  });
+  {
+    std::unique_lock<std::mutex> lock(mutex);
+    condition.wait(lock, [&]() {return entered;});
+    EXPECT_FALSE(handoff.claimControl());
+    requested = true;
+    condition.notify_one();
+  }
+  while (!handoff.claimControl()) {
+    std::this_thread::yield();
+  }
+  EXPECT_EQ(payload, 42);
+  producer.join();
+}
