+#include <gtest/gtest.h>
+
+#include <sstream>
+#include <string>
+
+#include "ethercat_interface/send_trace.hpp"
+
+TEST(SendTraceTest, IsBoundedAndFreezesAfterTheHandoffWindow)
+{
+  ethercat_interface::SendTrace trace;
+  trace.reset(true);
+  for (uint64_t i = 0; i < 2000; ++i) {
+    trace.record(i * 4000000, ethercat_interface::SendPhase::Startup, 48);
+  }
+  trace.record(8000000000, ethercat_interface::SendPhase::Maintenance, 48);
+  for (uint64_t i = 1; i <= 300; ++i) {
+    trace.record(8000000000 + i * 4000000, ethercat_interface::SendPhase::Control, 48);
+  }
+  std::ostringstream output;
+  trace.writeCsv(output);
+  std::istringstream input(output.str());
+  std::string line;
+  size_t lines = 0;
+  while (std::getline(input, line)) {++lines;}
+  EXPECT_EQ(lines, 1025U);
+  EXPECT_EQ(line, "");
+  EXPECT_NE(output.str().find("9024000000,control,48\n"), std::string::npos);
+  EXPECT_EQ(output.str().find("9028000000"), std::string::npos);
+  EXPECT_NE(output.str().find("8000000000,maintenance,48\n"), std::string::npos);
+}
+
+TEST(SendTraceTest, DisabledTraceDoesNotCollectSamples)
+{
+  ethercat_interface::SendTrace trace;
+  trace.reset(false);
+  trace.record(4, ethercat_interface::SendPhase::Startup, 48);
+  std::ostringstream output;
+  trace.writeCsv(output);
+  EXPECT_EQ(output.str(), "monotonic_ns,phase,working_counter\n");
+}
