@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef ETHERCAT_INTERFACE__SEND_TRACE_HPP_
+#define ETHERCAT_INTERFACE__SEND_TRACE_HPP_
+
+#include <time.h>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <ostream>
+
+namespace ethercat_interface
+{
+enum class SendPhase : uint8_t {Startup, Maintenance, Control};
+
+// Access follows cyclic ownership; export only after all senders have stopped.
+class SendTrace
+{
+public:
+  void reset(bool enabled) noexcept
+  {
+    enabled_ = enabled;
+    next_ = count_ = control_count_ = 0;
+  }
+
+  void record(uint64_t nanoseconds, SendPhase phase, uint32_t working_counter) noexcept
+  {
+    if (!enabled_) {
+      return;
+    }
+    samples_[next_] = {nanoseconds, phase, working_counter};
+    next_ = (next_ + 1) % samples_.size();
+    if (count_ < samples_.size()) {
+      ++count_;
+    }
+    if (phase == SendPhase::Control && ++control_count_ == 256) {
+      enabled_ = false;
+    }
+  }
+
+  void recordNow(SendPhase phase, uint32_t working_counter) noexcept
+  {
+    if (enabled_) {
+      timespec now{};
+      if (clock_gettime(CLOCK_MONOTONIC, &now) == 0) {
+        record(static_cast<uint64_t>(now.tv_sec) * 1000000000ULL + now.tv_nsec,
+          phase, working_counter);
+      }
+    }
+  }
+
+  void writeCsv(std::ostream & output) const
+  {
+    output << "monotonic_ns,phase,working_counter\n";
+    constexpr const char * names[] = {"startup", "maintenance", "control"};
+    const size_t first = (next_ + samples_.size() - count_) % samples_.size();
+    for (size_t i = 0; i < count_; ++i) {
+      const auto & sample = samples_[(first + i) % samples_.size()];
+      output << sample.nanoseconds << ',' << names[static_cast<size_t>(sample.phase)] << ',' <<
+        sample.working_counter << '\n';
+    }
+  }
+
+private:
+  struct Sample {uint64_t nanoseconds; SendPhase phase; uint32_t working_counter;};
+  std::array<Sample, 1024> samples_{};
+  size_t next_{0};
+  size_t count_{0};
+  size_t control_count_{0};
+  bool enabled_{false};
+};
+}  // namespace ethercat_interface
+
+#endif  // ETHERCAT_INTERFACE__SEND_TRACE_HPP_
