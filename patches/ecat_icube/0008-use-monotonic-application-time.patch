@@ -29,8 +29,9 @@
 #include <sstream>
 #include <thread>
 
+// Application time uses monotonic uptime, without a wall-clock epoch offset.
 #define EC_NEWTIMEVAL2NANO(TV) \
-  (((TV).tv_sec - 946684800ULL) * 1000000000ULL + (TV).tv_nsec)
+  (static_cast<uint64_t>((TV).tv_sec) * 1000000000ULL + (TV).tv_nsec)
 
