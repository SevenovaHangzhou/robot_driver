+int EcMaster::deactivate(uint32_t preop_timeout_ms)
+{
+  if (!master_active_) {
+    return 0;
+  }
+  if (master_ == NULL) {
+    return -ENODEV;
+  }
+
+  const int deactivate_result = ecrt_master_deactivate(master_);
+  if (deactivate_result != 0) {
+    printWarning(
+      "Deactivate. ecrt_master_deactivate failed with error " +
+      std::to_string(deactivate_result));
+    return deactivate_result;
+  }
+  master_active_ = false;
+
+  constexpr auto poll_interval = std::chrono::milliseconds(20);
+  const auto deadline =
+    std::chrono::steady_clock::now() + std::chrono::milliseconds(preop_timeout_ms);
+  uint16_t pending_position = 0;
+  uint8_t pending_al_state = 0;
+
+  while (true) {
+    bool all_preop = true;
+    for (const SlaveInfo & slave : slave_info_) {
+      ec_slave_info_t slave_state = {};
+      const int state_result = ecrt_master_get_slave(master_, slave.position, &slave_state);
+      if (state_result != 0) {
+        printWarning(
+          "Deactivate. Failed to read slave state at position " +
+          std::to_string(slave.position) + " with error " +
+          std::to_string(state_result));
+        return state_result;
+      }
+      if (slave_state.al_state != EC_AL_STATE_PREOP) {
+        all_preop = false;
+        pending_position = slave.position;
+        pending_al_state = slave_state.al_state;
+        break;
+      }
+    }
+
+    if (all_preop) {
+      return 0;
+    }
+    if (std::chrono::steady_clock::now() >= deadline) {
+      std::ostringstream message;
+      message << "Deactivate. Timed out waiting for slave at position "
+              << pending_position << " to reach clean PREOP; AL state 0x"
+              << std::hex << static_cast<unsigned int>(pending_al_state);
+      printWarning(message.str());
+      return -ETIMEDOUT;
+    }
+    std::this_thread::sleep_for(poll_interval);
+  }
+}
