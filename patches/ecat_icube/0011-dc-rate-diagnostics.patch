+          if (gap > statistics.maximum) {statistics.maximum = gap;}
+          const uint64_t bucket = gap / 1000;
+          ++statistics.histogram[bucket < 16000 ? bucket : 16000];
+        } else {
+          ++statistics.nonmonotonic;
+        }
+      }
+      previous_valid_ = true;
+      previous_ns_ = nanoseconds;
+      previous_phase_ = phase;
+    }
     if (!enabled_) {
       return;
     }
