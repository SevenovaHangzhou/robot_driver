diff --git a/ethercat_interface/test/test_diagnostic_timing.cpp b/ethercat_interface/test/test_diagnostic_timing.cpp
new file mode 100644
index 0000000..984029d
--- /dev/null
+++ b/ethercat_interface/test/test_diagnostic_timing.cpp
@@ -0,0 +1,33 @@
+#include <gtest/gtest.h>
+
+#include "ethercat_interface/diagnostic_timing.hpp"
+
+using ethercat_interface::diagnosticUnsigned;
+using ethercat_interface::validateActivationDeadline;
+using ethercat_interface::validateSyncShift;
+
+TEST(DiagnosticTimingTest, RejectsInvalidUnsignedSettings)
+{
+  for (const char * text : {"", "-1", "+1", " 1", "1x", "18446744073709551616"}) {
+    EXPECT_THROW(diagnosticUnsigned(text), std::exception) << text;
+  }
+  EXPECT_EQ(diagnosticUnsigned("120000000000"), 120000000000ULL);
+}
+
+TEST(DiagnosticTimingTest, DeadlineMustBeFutureAndBounded)
+{
+  EXPECT_EQ(validateActivationDeadline(1500000000, 1000000000), 1500000000ULL);
+  EXPECT_THROW(validateActivationDeadline(1000000000, 1000000000), std::exception);
+  EXPECT_THROW(validateActivationDeadline(999999999, 1000000000), std::exception);
+  EXPECT_THROW(validateActivationDeadline(62000000000ULL, 1000000000), std::exception);
+}
+
+TEST(DiagnosticTimingTest, CommonPhaseFitsEverySupportedExperimentPeriod)
+{
+  for (uint32_t interval : {4000000U, 2000000U, 1000000U}) {
+    EXPECT_EQ(validateSyncShift(0, interval), 0U);
+    EXPECT_EQ(validateSyncShift(interval - 1, interval), interval - 1);
+    EXPECT_THROW(validateSyncShift(interval, interval), std::exception);
+  }
+  EXPECT_THROW(validateSyncShift(0, 0), std::exception);
+}
diff --git a/ethercat_interface/test/test_send_trace.cpp b/ethercat_interface/test/test_send_trace.cpp
index b1b9917..c79d8b4 100644
--- a/ethercat_interface/test/test_send_trace.cpp
+++ b/ethercat_interface/test/test_send_trace.cpp
@@ -38,3 +38,34 @@ TEST(SendTraceTest, DisabledTraceDoesNotCollectSamples)
   trace.writeCsv(output);
   EXPECT_EQ(output.str(), "monotonic_ns,phase,working_counter\n");
 }
+
+TEST(SendTraceTest, RuntimeStatisticsContinueAfterTheRawWindowFreezes)
+{
+  ethercat_interface::SendTrace trace;
+  trace.reset(true);
+  for (uint64_t i = 1; i <= 300; ++i) {
+    trace.record(i * 1000000, ethercat_interface::SendPhase::Control, 48, i != 280);
+  }
+  std::ostringstream statistics, histogram;
+  trace.writeStatisticsCsv(statistics);
+  trace.writeHistogramCsv(histogram);
+  EXPECT_NE(statistics.str().find("control,300,299,1000000,1000000,1,0\n"), std::string::npos);
+  EXPECT_NE(histogram.str().find("control,1000,299\n"), std::string::npos);
+  trace.reset(false);
+  std::ostringstream cleared;
+  trace.writeStatisticsCsv(cleared);
+  EXPECT_NE(cleared.str().find("control,0,0,0,0,0,0\n"), std::string::npos);
+}
+
+TEST(SendTraceTest, PhaseChangesAndBackwardsTimeDoNotBecomeValidCycleGaps)
+{
+  ethercat_interface::SendTrace trace;
+  trace.reset(true);
+  trace.record(1000000, ethercat_interface::SendPhase::Startup, 48);
+  trace.record(2000000, ethercat_interface::SendPhase::Control, 48);
+  trace.record(1000000, ethercat_interface::SendPhase::Control, 48);
+  trace.record(18000000, ethercat_interface::SendPhase::Control, 48);
+  std::ostringstream output;
+  trace.writeStatisticsCsv(output);
+  EXPECT_NE(output.str().find("control,3,1,17000000,17000000,0,1\n"), std::string::npos);
+}
