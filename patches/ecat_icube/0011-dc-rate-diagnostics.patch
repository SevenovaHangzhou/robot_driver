+++ b/ethercat_interface/include/ethercat_interface/diagnostic_timing.hpp
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef ETHERCAT_INTERFACE__DIAGNOSTIC_TIMING_HPP_
+#define ETHERCAT_INTERFACE__DIAGNOSTIC_TIMING_HPP_
+
+#include <cstdint>
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+#include <time.h>
+
+namespace ethercat_interface
+{
+inline uint64_t diagnosticUnsigned(const char * setting)
+{
+  const std::string value(setting == nullptr ? "" : setting);
+  if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos) {
+    throw std::invalid_argument("Diagnostic timing value must be an unsigned decimal integer");
+  }
+  return std::stoull(value);
+}
+
+inline uint64_t validateActivationDeadline(uint64_t deadline, uint64_t now)
+{
+  if (deadline <= now || deadline - now > 60000000000ULL) {
+    throw std::invalid_argument("Diagnostic activation deadline must be within the next 60 seconds");
+  }
+  return deadline;
+}
+
+inline uint32_t validateSyncShift(uint64_t shift, uint32_t interval)
+{
+  if (interval == 0 || shift >= interval) {
+    throw std::invalid_argument("Diagnostic SYNC0 shift must be smaller than the cycle period");
+  }
+  return static_cast<uint32_t>(shift);
+}
+
+inline bool waitForDiagnosticActivation()
+{
+  const char * setting = std::getenv("RT_CONTROL_ECAT_ACTIVATE_AT_NS");
+  if (setting == nullptr) {
+    return true;
+  }
+  timespec now{};
+  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+    return false;
+  }
+  const uint64_t deadline = validateActivationDeadline(diagnosticUnsigned(setting),
+    static_cast<uint64_t>(now.tv_sec) * 1000000000ULL + now.tv_nsec);
+  const timespec wake{static_cast<time_t>(deadline / 1000000000ULL),
+    static_cast<long>(deadline % 1000000000ULL)};
+  // A signal interrupts the experiment before activation instead of extending startup.
+  return clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &wake, nullptr) == 0;
+}
+}  // namespace ethercat_interface
+
+#endif  // ETHERCAT_INTERFACE__DIAGNOSTIC_TIMING_HPP_
