   }
 
+  void writeStatisticsCsv(std::ostream & output) const
+  {
+    output << "phase,samples,gaps,min_gap_ns,max_gap_ns,wkc_incomplete,nonmonotonic\n";
+    constexpr const char * names[] = {"startup", "maintenance", "control"};
+    for (size_t phase = 0; phase < statistics_.size(); ++phase) {
+      const auto & value = statistics_[phase];
+      output << names[phase] << ',' << value.samples << ',' << value.gaps << ',' <<
+        value.minimum << ',' << value.maximum << ',' << value.incomplete << ',' <<
+        value.nonmonotonic << '\n';
+    }
+  }
+
+  void writeHistogramCsv(std::ostream & output) const
+  {
+    output << "phase,gap_us,count\n";
+    constexpr const char * names[] = {"startup", "maintenance", "control"};
+    for (size_t phase = 0; phase < statistics_.size(); ++phase) {
+      for (size_t bucket = 0; bucket < statistics_[phase].histogram.size(); ++bucket) {
+        const uint64_t count = statistics_[phase].histogram[bucket];
+        if (count) {output << names[phase] << ',' << bucket << ',' << count << '\n';}
+      }
+    }
+  }
+
 private:
+  struct Statistics
+  {
+    uint64_t samples{0}, gaps{0}, minimum{0}, maximum{0}, incomplete{0}, nonmonotonic{0};
+    // One-microsecond bins; the last bin contains every gap >= 16 ms.
+    std::array<uint64_t, 16001> histogram{};
+  };
+  std::array<Statistics, 3> statistics_{};
+  bool statistics_enabled_{false};
+  bool previous_valid_{false};
+  uint64_t previous_ns_{0};
+  SendPhase previous_phase_{SendPhase::Startup};
   struct Sample {uint64_t nanoseconds; SendPhase phase; uint32_t working_counter;};
   std::array<Sample, 1024> samples_{};
   size_t next_{0};
